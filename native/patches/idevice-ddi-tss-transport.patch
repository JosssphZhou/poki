+/// Classifies the result at the DDI signing-request boundary, before device errors are combined.
+/// Only the I/O kind is retained; request bodies and device identifiers are never included.
+#[doc(hidden)]
+pub fn ddi_signing_response(result: Result<plist::Value, IdeviceError>) -> Result<plist::Value, IdeviceError> {
+    result.map_err(|error| match error {
+        IdeviceError::Socket(io) => IdeviceError::Http(format!(
+            "Apple signing server socket failed ({:?})", io.kind()
+        )),
+        other => other,
+    })
+}
