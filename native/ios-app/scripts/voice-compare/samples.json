    "shared_replay_contract": "-pokiVoiceLink \"poki://voice?bridge=<address>&test=<n>-<n>&muted=1\" with bin/voice-bridge.mjs --test-dir <dir> serving uNN.24k.pcm (24 kHz mono PCM16) and recording voice-test-report.jsonl",
