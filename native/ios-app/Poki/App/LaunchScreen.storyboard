<?xml version="1.0" encoding="UTF-8"?>
<!-- The screen iOS shows while Poki opens: the icon picture in the middle, 120 points, where the launch screen has
     always had it, on a ground that meets the picture on every side so the square does not show. A band of the
     picture's own ground colours, row for row, runs across the screen behind it; the top row's colour fills
     everything above and the bottom row's everything below. The pictures are made by scripts/make-assets.sh.
     All of it is laid out against the whole screen, not the safe area. LaunchCover shows this same storyboard
     again as the app's first frame. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="Launch-top" translatesAutoresizingMaskIntoConstraints="NO" id="top">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="366"/>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="Launch-bottom" translatesAutoresizingMaskIntoConstraints="NO" id="bottom">
                                <rect key="frame" x="0.0" y="486" width="393" height="366"/>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="Launch-band" translatesAutoresizingMaskIntoConstraints="NO" id="band">
                                <rect key="frame" x="0.0" y="366" width="393" height="120"/>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="Launch-bear" translatesAutoresizingMaskIntoConstraints="NO" id="bear">
                                <rect key="frame" x="136.5" y="366" width="120" height="120"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe"/>
                        <color key="backgroundColor" red="0.40392156862745099" green="0.59999999999999998" blue="0.85098039215686272" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="bear" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="bx"/>
                            <constraint firstItem="bear" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="by"/>
                            <constraint firstItem="bear" firstAttribute="width" constant="120" id="bw"/>
                            <constraint firstItem="bear" firstAttribute="height" constant="120" id="bh"/>
                            <constraint firstItem="band" firstAttribute="top" secondItem="bear" secondAttribute="top" id="dt"/>
                            <constraint firstItem="band" firstAttribute="bottom" secondItem="bear" secondAttribute="bottom" id="db"/>
                            <constraint firstItem="band" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="dl"/>
                            <constraint firstItem="band" firstAttribute="trailing" secondItem="root" secondAttribute="trailing" id="dr"/>
                            <constraint firstItem="top" firstAttribute="top" secondItem="root" secondAttribute="top" id="tt"/>
                            <constraint firstItem="top" firstAttribute="bottom" secondItem="bear" secondAttribute="top" id="tb"/>
                            <constraint firstItem="top" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="tl"/>
                            <constraint firstItem="top" firstAttribute="trailing" secondItem="root" secondAttribute="trailing" id="tr"/>
                            <constraint firstItem="bottom" firstAttribute="top" secondItem="bear" secondAttribute="bottom" id="ot"/>
                            <constraint firstItem="bottom" firstAttribute="bottom" secondItem="root" secondAttribute="bottom" id="ob"/>
                            <constraint firstItem="bottom" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="ol"/>
                            <constraint firstItem="bottom" firstAttribute="trailing" secondItem="root" secondAttribute="trailing" id="or"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="Launch-band" width="4" height="120"/>
        <image name="Launch-bear" width="120" height="120"/>
        <image name="Launch-bottom" width="4" height="4"/>
        <image name="Launch-top" width="4" height="4"/>
    </resources>
</document>
