            "value" : "Poki"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki uses the camera to take photos you send in a message, and to scan the pairing code from Poki Setup on your computer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 使用相机拍摄你在对话中发送的照片，以及扫描电脑上 Poki Setup 显示的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 使用相機拍攝你在對話中傳送的照片，以及掃描電腦上 Poki Setup 顯示的配對碼。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki connects to developer services on this iPhone for pairing and automation, and to the voice bridge on your Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 会连接此 iPhone 的开发者服务以完成配对和自动化，并连接 Mac 上的语音桥接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 會連線此 iPhone 的開發者服務以完成配對與自動化，並連線 Mac 上的語音橋接。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki stays active in the background while on so agents can reach this iPhone. Poki never records or sends your location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 开启时会在后台保持运行，以便智能体连接此 iPhone。Poki 不会记录或发送你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 開啟時會在背景保持執行，以便代理程式連線此 iPhone。Poki 不會記錄或傳送你的位置。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki stays active in the background while on so agents can reach this iPhone. Poki never records or sends your location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 开启时会在后台保持运行，以便智能体连接此 iPhone。Poki 不会记录或发送你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 開啟時會在背景保持執行，以便代理程式連線此 iPhone。Poki 不會記錄或傳送你的位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki listens when you talk in Voice and sends the audio to OpenAI to understand your request."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在“语音”中与 Poki 交谈时，Poki 会收音并将音频发给 OpenAI 以理解你的请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在「語音」中與 Poki 交談時，Poki 會收音並將音訊傳送給 OpenAI 以理解你的請求。"
          }
        }
      }
    }
  },
  "version" : "1.0"
