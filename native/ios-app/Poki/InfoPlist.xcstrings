    },
    "NSCameraUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poki uses the camera only to scan the pairing code Poki Setup shows on your computer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 只用相机扫描电脑上 Poki Setup 显示的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 只用相機掃描電腦上 Poki Setup 顯示的配對碼。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poki connects to this iPhone's own developer services to pair with it and to run the automation, and to the voice bridge on your Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 会连接此 iPhone 自身的开发者服务，用于配对和运行自动化，也会连接你 Mac 上的语音中转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 會連線此 iPhone 自身的開發者服務，用於配對和執行自動化，也會連線你 Mac 上的語音中轉。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poki keeps running in the background while it is on, so agents can reach this iPhone. Poki does not record or send your location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 开启时会在后台保持运行，让智能体能连上此 iPhone。Poki 不会记录或发送你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 開啟時會在後臺保持執行，讓AI 代理能連上此 iPhone。Poki 不會記錄或傳送你的位置。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poki keeps running in the background while it is on, so agents can reach this iPhone. Poki does not record or send your location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 开启时会在后台保持运行，让智能体能连上此 iPhone。Poki 不会记录或发送你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 開啟時會在後臺保持執行，讓AI 代理能連上此 iPhone。Poki 不會記錄或傳送你的位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poki listens while you speak. Live Voice sends audio to the provider you use for voice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说话时，Poki 会收音。实时语音会把音频发送给你选用的语音服务商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你說話時，Poki 會收音。即時語音會把音訊傳送給你選用的語音服務供應商。"
          }
        }
      }
    }
