    },
    "A client (%@) is signing in with %@. Open Poki to allow or deny it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户端（%1$@）正在使用 %2$@ 登录。打开 Poki 以允许或拒绝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用戶端（%1$@）正在使用 %2$@ 登入。打開 Poki 以允許或拒絕。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một máy khách (%@) đang đăng nhập bằng %@. Mở Poki để cho phép hoặc từ chối."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A client (%@) is signing in with %@. Open Poki to allow or deny it."
          }
        }
      }
    },
    "A guest is borrowing Poki’s hands. You can tap Stop anytime." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
