          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã chọn %@, nhưng hiện không có phản hồi tại 10.7.0.1. Mở %lld, đảm bảo đã kết nối và bật loopback rồi quay lại. Trang này tự động cập nhật."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
