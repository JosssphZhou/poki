        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quy trình và ghi chú Poki lưu giữ"
          }
        }
      }
    },
    "An agent saves a routine after a task that worked. The next time it repeats the task in one step and stops where the screen differs. Swipe a routine to forget it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务成功后，智能体会保存流程以便下次一步重放，遇到界面变化则自动停下。轻扫可删除流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任務成功後，智慧體會儲存流程以便下次一步重放，遇到畫面變化則自動停下。輕掃可刪除流程。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tác nhân sẽ lưu một quy trình sau khi tác vụ thành công. Lần sau, nó lặp lại tác vụ chỉ trong một bước và dừng lại ở chỗ màn hình khác đi. Vuốt một quy trình để quên."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a successful task, an agent saves a routine to repeat it in one step next time, pausing if the screen differs. Swipe to forget."
          }
        }
      }
    },
    "e.g., Mom is “Mama” in Contacts" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如，妈妈在通讯录中叫“Mama”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如，媽媽在通訊錄中叫「Mama」"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vd: Mẹ là “Mama” trong Danh bạ"
          }
        }
      }
    },
    "Notes" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备忘"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備忘"
          }
        },
        "vi" : {
