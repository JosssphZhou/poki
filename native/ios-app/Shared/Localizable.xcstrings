          }
        }
      }
    },
    "iOS asks for the passcode before UI Automation after Poki Runner was force-closed or the iPhone restarted. Enter it once and Poki carries on by itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki Runner 被强制退出或 iPhone 重新启动后，iOS 会先要求输入锁屏密码，再允许 UI 自动化。只需输入一次，Poki 会自动继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki Runner 被強制退出或 iPhone 重新啟動後，iOS 會先要求輸入鎖屏密碼，再允許 UI 自動化。只需輸入一次，Poki 會自動繼續。"
          }
        }
      }
    },
    "iOS asks for the passcode to allow UI Automation after Poki restarts, or 8 hours after it was last entered. Enter it once and Poki carries on by itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 重启后，或距上次输入密码超过 8 小时，iOS 会要求输入密码以允许 UI 自动化。输入一次即可，Poki 会自己继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 重啟後，或距上次輸入密碼超過 8 小時，iOS 會要求輸入密碼以允許 UI 自動化。輸入一次即可，Poki 會自己繼續。"
          }
        }
      }
    },
    "iOS requires a background mode to keep apps running. Poki uses lowest-accuracy location and shows the location indicator while active." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 要求 App 声明特定用途才能在后台持续运行。Poki 会以最低精度使用定位服务，并在运行期间显示定位指示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 要求 App 宣告特定用途才能在後臺持續執行。Poki 會以最低精度使用定位服務，並在執行期間顯示定位指示器。"
          }
        }
      }
    },
    "iOS shows the automation banner only while Poki’s automation session is open. Poki opens it when an agent asks and closes it when idle." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在自动化会话开启时显示系统横幅。智能体请求时自动开启，闲置时关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在自動化工作階段開啟時顯示系統橫幅。智慧體請求時自動開啟，閒置時關閉。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS shows the automation banner only during an active session. Poki opens it on agent request and closes it when idle."
          }
        }
      }
    },
    "iOS shows the automation banner only while the runner is active. Poki starts it when needed and stops it when idle. Don’t close Poki Runner while an agent is working." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在 Runner 运行时显示系统横幅。按需启动，闲置停止。智能体工作时请勿关闭 Poki Runner。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在 Runner 執行時顯示系統橫幅。按需啟動，閒置停止。智慧體工作時請勿關閉 Poki Runner。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS shows the automation banner only while Runner is active. Poki starts it when needed and stops it when idle. Don’t close Poki Runner while an agent is working."
          }
        }
      }
    },
