    },
    "A client Poki doesn’t know (%@) is signing in with %@. Open Poki to allow or deny it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开 Poki 允许或拒绝。未知客户端（%@）正通过 %@ 登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟 Poki 允許或拒絕。未知用戶端（%@）正透過 %@ 登入。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Poki to allow or deny sign-in. An unrecognized client (%@) is signing in with %@."
