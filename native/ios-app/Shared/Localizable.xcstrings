    "Keep your usual keyboards. Poki switches to its keyboard when it types and back to yours when it is done." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留你常用的键盘。Poki 键入时会切换到自己的键盘，完成后切回你的键盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
