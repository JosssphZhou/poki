    "the pairing file from a computer does not work over the loopback on this iOS version. Pair this iPhone here once and the pairing stays." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在此 iPhone 上直接配对一次（配对会保留）。当前 iOS 版本不支持通过本地连接使用电脑配对文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在此 iPhone 上直接配對一次（配對會保留）。目前 iOS 版本不支援透過本機連線使用電腦配對檔案。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tệp ghép nối từ máy tính không hoạt động qua kết nối cục bộ trên phiên bản iOS này. Hãy ghép nối iPhone này tại đây một lần và kết nối ghép nối sẽ được lưu lại."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair directly on this iPhone once (the pairing stays). Computer pairing files don’t work over Loopback on this iOS version."
          }
        }
      }
    },
