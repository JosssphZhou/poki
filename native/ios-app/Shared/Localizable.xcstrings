        }
      }
    },
    "Tap to Open Poki" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点以打开 Poki"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
