            "value" : "Two ways to update: sign in to update directly here, or connect this iPhone to your Mac and use Poki Setup."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援兩種更新方式：登入帳號在此直接更新，或連線 Mac 使用 Poki Setup 更新。"
          }
        }
      }
    },
