    "I think with a model from your own account. Sign in or add a key. You can change it any time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I think with a model from your own account. Sign in or add a key. You can change it any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我用你自己账户里的模型思考。登录或添加密钥，之后随时可以换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
