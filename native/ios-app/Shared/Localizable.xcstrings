      }
    },
    "unlock this iPhone and trust the pairing" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先解锁此 iPhone 并信任配对"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先解鎖此 iPhone 並信任配對"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mở khóa iPhone này và tin cậy ghép nối"
          }
        }
      }
    },
    "the pairing file from a computer does not work on this iOS version" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑生成的配对文件不适用于当前 iOS 版本"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦產生的配對檔案不適用於目前 iOS 版本"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tệp ghép nối từ máy tính không hoạt động trên phiên bản iOS này"
          }
        }
      }
    },
    "The phone refused the pairing. Pair again in Setup." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair again in Setup. This iPhone refused the pairing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“配置”中重新配对。iPhone 拒绝了当前配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「配置」中重新配對。iPhone 拒絕了目前配對。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điện thoại đã từ chối ghép nối. Hãy ghép nối lại trong Thiết lập."
          }
        }
      }
    },
    "The phone no longer accepts Poki’s pairing. Pair again in Setup; it takes a minute." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 已不再接受当前配对，请在“配置”中重新配对（约需 1 分钟）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 已不再接受目前配對，請在「配置」中重新配對（約需 1 分鐘）。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điện thoại không còn chấp nhận ghép nối của Poki. Hãy ghép nối lại trong Thiết lập; chỉ mất khoảng 1 phút."
          }
        }
      }
    },
    "Enter your relay’s address first in Settings › External Connections › Address. Poki has no default relay." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your relay address in Settings › External Connections › Address first. Poki has no default relay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在“设置 › 外部连接 › 服务地址”中填写远程连接服务地址。Poki 没有默认远程连接服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在「設定 › 外部連線 › 服務地址」中填寫遠端連線服務位址。Poki 沒有預設遠端連線服務。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhập địa chỉ dịch vụ chuyển tiếp trước trong Cài đặt › Kết nối ngoài › Địa chỉ. Poki không có dịch vụ chuyển tiếp mặc định."
          }
        }
      }
    },
    "Poki is offline (%@). Check that the phone has internet; Poki reconnects by itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki is offline (%@). Check your internet connection; Poki reconnects automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 已离线（%@）。请检查网络连接，联网后会自动重连。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 已離線（%@）。請檢查網路連線，連網後會自動重連。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki đang ngoại tuyến (%@). Hãy kiểm tra kết nối mạng của điện thoại; Poki sẽ tự kết nối lại."
          }
        }
      }
    },
