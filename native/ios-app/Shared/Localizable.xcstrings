      }
    },
    "Keep your usual keyboards. Poki switches to its keyboard when it types and back to yours when it is done. Full Access lets the panel talk to Poki on this iPhone. It has no network access and never uses the clipboard." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留你常用的键盘。Poki 键入时会切换到自己的键盘，完成后切回你的键盘。完全访问让键盘面板能与此 iPhone 上的 Poki 通信。它没有网络访问权限，也从不使用剪贴板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留你常用的鍵盤。Poki 鍵入時會切換到自己的鍵盤，完成後切回你的鍵盤。完全訪問讓鍵盤面板能與此 iPhone 上的 Poki 通訊。它沒有網路訪問許可權，也從不使用剪貼簿。"
          }
        }
      }
    },
    "Create routines from user demonstrations" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据用户示范创建流程"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據使用者示範建立流程"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create routines from user demonstrations"
          }
        }
      }
    },
    "Experimental. Observed corrections become user-assisted checkpoints, never guessed taps or unattended replay. Off by default." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实验性功能。观察到的纠正会成为由用户协助的检查点，绝不会变成猜测的轻点或无人值守的重放。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "實驗性功能。觀察到的糾正會成為由使用者協助的檢查點，絕不會變成猜測的輕點或無人值守的重放。預設關閉。"
          }
        }
      }
    },
