    "This build has no local VPN. Choose an external connection, or install the build with the local VPN and supported signing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择外部代理通道，或安装含 内置本地连接且采用受支持签名方式的版本。当前版本不含 内置本地连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇外部代理通道，或安裝含 內建本機連線且採用受支援簽名方式的版本。目前版本不含 內建本機連線。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng này không có VPN cục bộ. Hãy chọn kết nối ngoài, hoặc cài bản dựng có VPN cục bộ với chữ ký được hỗ trợ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an external connection, or install the build with the local VPN and supported signing. This build has no local VPN."
          }
        }
      }
    },
    "This build uses an external connection. For the built-in connection, install the local-VPN build with signing that supports Network Extensions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本使用外部代理通道。如需 内置本地连接，请安装带 内置本地连接的版本，并使用支持网络扩展的签名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本使用外部代理通道。如需 內建本機連線，請安裝帶 內建本機連線的版本，並使用支援網路擴充套件的簽名。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng này dùng kết nối ngoài. Để dùng kết nối tích hợp, hãy cài bản dựng có VPN cục bộ với chữ ký hỗ trợ Network Extensions."
          }
        }
      }
    },
    "This feature requires a newer version of iOS." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 iOS 以使用此功能。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update iOS to use this feature."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新 iOS 以使用此功能。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng này yêu cầu phiên bản iOS mới hơn."
          }
        }
      }
    },
    "This happens after a restore, a reset of Location & Privacy, or when the phone forgot Poki. Pair again and the old key is replaced." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复 iPhone、还原“位置与隐私”或 iPhone 忘记 Poki 后会出现这种情况。重新配对即可，旧密钥会被替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢復 iPhone、還原「位置與隱私」或 iPhone 忘記 Poki 後會出現這種情況。重新配對即可，舊金鑰會被替換。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này xảy ra sau khi khôi phục, đặt lại Vị trí & Quyền riêng tư, hoặc khi điện thoại quên Poki. Hãy ghép nối lại để thay thế khóa cũ."
          }
        }
      }
    },
    "This iOS version needs a newer developer disk image. Open Poki's setup to download the latest image, or update Poki." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“配置”中下载最新开发者磁盘映像，或更新 Poki 以适配当前 iOS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「配置」中下載最新開發者磁碟映像，或更新 Poki 以適配目前 iOS。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản iOS này cần ảnh đĩa nhà phát triển mới hơn. Mở Thiết lập của Poki để tải ảnh mới nhất hoặc cập nhật Poki."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Setup to download the latest developer disk image, or update Poki for this iOS version."
          }
        }
      }
    },
    "This iPhone" : {
      "localizations" : {
