    "Poki uses the first address. When it can’t be reached, Poki tries the next ones that speak the same API, in order." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 使用第一个地址。无法连接时，Poki 会依次尝试使用相同 API 的其他地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
