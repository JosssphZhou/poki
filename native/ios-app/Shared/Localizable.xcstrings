    "Poki couldn’t read its relay key from the keychain (%@)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 无法从钥匙串读取中转密钥（%@）。"
