        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki dùng địa chỉ đầu tiên. Khi không kết nối được, Poki sẽ lần lượt thử các địa chỉ tiếp theo dùng cùng API."
          }
        }
      }
    },
