    "The first time Poki Runner starts after a restart, iOS asks for your passcode to allow automation. Enter it once; Poki never sees it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 重新启动后首次启动 Poki Runner 时，iOS 会要求输入锁屏密码以允许自动化操作。只需输入一次，Poki 无法读取该密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 重新啟動後首次啟動 Poki Runner 時，iOS 會要求輸入鎖屏密碼以允許自動化操作。只需輸入一次，Poki 無法讀取該密碼。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần đầu Poki Runner khởi chạy sau khi khởi động lại, iOS sẽ yêu cầu mật mã để cho phép tự động hóa. Chỉ cần nhập một lần; Poki không bao giờ thấy mật mã này."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time Poki Runner starts after a restart, iOS asks for your passcode to allow automation. Enter it once. Poki never sees it."
          }
        }
