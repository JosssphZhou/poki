    },
    "Off by default. ask_poki lets outside agents hand a repetitive task to Poki's own agent. Changes take effect the next time Poki opens. The Auto-Classifier is in Agents › Approvals." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。ask_poki 让外部智能体把重复性任务交给 Poki 自己的智能体。更改在下次打开 Poki 时生效。自动分类器位于“智能体 › 批准”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設關閉。ask_poki 讓外部AI 代理把重複性任務交給 Poki 自己的AI 代理。更改在下次開啟 Poki 時生效。自動分類器位於「AI 代理 › 批准」。"
          }
        }
      }
    },
    "Input Without Screen Sharing" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不使用屏幕共享发送输入"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不使用螢幕共享傳送輸入"
          }
        }
      }
    },
    "Touches and Keys" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触控与按键"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸控與按鍵"
          }
        }
      }
    },
    "Poki sends touches and keys over a screen-sharing session, and iOS turns the camera off in every app while one is open, so Poki opens it only for an action and closes it 5 seconds after the last one. With this on (the default), Poki opens no session at all, so the camera is never affected. If taps and typing stop working, turn it off. Takes effect the next time Poki turns on." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 通过屏幕共享会话发送触控和按键，而会话打开期间 iOS 会关闭所有 App 的相机，因此 Poki 只在操作时打开会话，并在最后一次操作 5 秒后关闭。开启此项（默认）后，Poki 完全不打开会话，相机不受任何影响。如果轻点和键入失效，请关闭此项。下次开启 Poki 时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 透過螢幕共享會話傳送觸控和按鍵，而會話開啟期間 iOS 會關閉所有 App 的相機，因此 Poki 只在操作時開啟會話，並在最後一次操作 5 秒後關閉。開啟此項（預設）後，Poki 完全不開啟會話，相機不受任何影響。如果輕點和鍵入失效，請關閉此項。下次開啟 Poki 時生效。"
          }
        }
      }
    },
    "Agents can reach this iPhone" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体可以连接此 iPhone"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 代理可以連線此 iPhone"
          }
        }
      }
    },
