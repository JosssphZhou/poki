    "That verification code is incorrect. Check the 6-digit code and enter the newest code you received." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That verification code is incorrect. Check the 6-digit code and enter the newest code you received."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证码不对，请核对后输入你收到的六位验证码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證碼不對，請核對後輸入你收到的六位驗證碼。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã xác minh không đúng. Kiểm tra mã 6 chữ số và nhập mã mới nhất bạn nhận được."
          }
        }
      }
    },
    "That verification code is incorrect. Stop and wait a few minutes before trying again so Apple does not lock this Apple Account, then enter the newest 6-digit code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That verification code is incorrect. Stop and wait a few minutes before trying again so Apple does not lock this Apple Account, then enter the newest 6-digit code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证码不对。请先停下来等几分钟，以免 Apple 锁定该账号，之后再输入最新收到的六位验证码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證碼不對。請先停下來等幾分鐘，以免 Apple 鎖定該帳號，之後再輸入最新收到的六位驗證碼。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã xác minh không đúng. Dừng lại và đợi vài phút trước khi thử lại để Apple không khóa Tài khoản Apple này, rồi nhập mã 6 chữ số mới nhất."
          }
        }
      }
    },
    "That verification code has expired. Enter the newest 6-digit code, or request a new code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That verification code has expired. Enter the newest 6-digit code, or request a new code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证码已过期，请输入最新一条验证码，或点“重新发送验证码”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證碼已過期，請輸入最新一條驗證碼，或點「重新傳送驗證碼」。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã xác minh đã hết hạn. Nhập mã 6 chữ số mới nhất hoặc yêu cầu mã mới."
          }
        }
      }
    },
    "Apple has had too many sign-in attempts or codes for this Apple Account. Wait about an hour before you sign in again, because each new try asks Apple for another code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple has had too many sign-in attempts or codes for this Apple Account. Wait about an hour before you sign in again, because each new try asks Apple for another code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 Apple 账户的登录或验证码请求次数过多，请等待约一小时后再试，以免每次重试继续向 Apple 请求新验证码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該 Apple 帳號的登入或驗證碼請求次數過多，請等待約一小時後再試，以免每次重試繼續向 Apple 請求新驗證碼。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có quá nhiều lần thử đăng nhập hoặc yêu cầu mã cho Tài khoản Apple này. Đợi khoảng một giờ trước khi đăng nhập lại, vì mỗi lần thử mới lại yêu cầu Apple gửi thêm mã."
          }
        }
      }
    },
    "Apple verified the code, but did not finish opening the session. Sign in again to start a fresh session." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple verified the code, but did not finish opening the session. Sign in again to start a fresh session."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 已验证该验证码，但未完成会话建立。请重新登录以发起新会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 已驗證該驗證碼，但未完成工作階段建立。請重新登入以發起新工作階段。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple đã xác minh mã nhưng chưa hoàn tất mở phiên. Đăng nhập lại để bắt đầu phiên mới."
          }
        }
      }
    },
    "%@ skills" : {
        "localizations" : {
            "en" : {
                "stringUnit" : {
                    "state" : "translated",
                    "value" : "%@ skills"
                }
            },
