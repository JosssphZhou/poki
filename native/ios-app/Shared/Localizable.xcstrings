    },
    "The run log lists each routine run, where it stopped and how long it took, with no typed text. It helps the Poki maintainers make routines more reliable." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录每次流程执行结果、停止位置与耗时（不含输入文本），协助维护者提升流程稳定性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄每次流程執行結果、停止位置與耗時（不含輸入文字），協助維護者提升流程穩定性。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs each routine run, where it stopped, and duration, without typed text. Helps maintainers improve routine reliability."
          }
        }
      }
    },
