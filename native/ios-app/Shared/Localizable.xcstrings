    "10.7.0.1 takes the connection, but the phone's remote pairing service does not answer through it, so this page can show Working while Poki cannot connect. Reconnect your proxy app or LocalDevVPN, then pair again in Setup › Pairing." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新连接 LocalDevVPN 或代理 App，再到“配置 › 配对”重新配对。10.7.0.1 已连通，但远程配对服务未响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重新連線 LocalDevVPN 或代理 App，再到「設定精靈 › 配對」重新配對。10.7.0.1 已連通，但遠端配對服務未回應。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnect LocalDevVPN or your proxy app, then pair again in Setup › Pairing. 10.7.0.1 accepts connections, but remote pairing isn’t answering through it."
          }
        }
      }
    },
    "2 minutes" : {
