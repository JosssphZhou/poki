    "Tripped at step %lld" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第 %lld 步受阻"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped at step %lld"
