    "Show me the full plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show me the full plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给我看看完整计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給我看看完整計劃。"
          }
        }
      }
    },
    "Your plan is ready. You can review it here and make changes whenever you like.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan is ready. You can review it here and make changes whenever you like."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天的计划已准备好。你可以随时查看安排，或继续告诉我需要调整的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明天的計劃已準備好。你可以隨時查看安排，或繼續告訴我需要調整的地方。"
          }
        }
      }
    },
    "Help me plan tomorrow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me plan tomorrow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我安排一下明天的计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫我安排一下明天的計劃。"
          }
        }
      }
    },
    "Start with your most important task in the morning. Leave time for lunch and a short walk.\n\nI can also help you set a reminder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with your most important task in the morning. Leave time for lunch and a short walk.\n\nI can also help you set a reminder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上午先完成最重要的事情，午间留出吃饭和散步的时间。\n\n我还可以帮你设置提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上午先完成最重要的事情，午間留出吃飯和散步的時間。\n\n我還可以幫你設定提醒。"
          }
        }
      }
    },
