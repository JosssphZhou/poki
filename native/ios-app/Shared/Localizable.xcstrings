    "Could not start Poki's local VPN. Allow the VPN configuration when asked. If signing does not include Network Extensions, use the external-connection build with LocalDevVPN or a compatible proxy." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在弹窗中允许 VPN 配置；若签名不含网络扩展，请改用外部连接版搭配 LocalDevVPN 或代理。无法启动本机 VPN。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在彈窗中允許 VPN 設定；若簽名不含網路延伸功能，請改用外部連線版搭配 LocalDevVPN 或代理。無法啟動本機 VPN。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow the VPN configuration if prompted, or use the external-connection build with LocalDevVPN or a proxy if signing lacks Network Extensions. Couldn’t start Poki’s local VPN."
          }
        }
      }
    },
    "The local VPN disconnected. Reconnect here. If it keeps stopping, check that both Poki and its tunnel were signed with Network Extensions, or choose an external connection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在此重新连接；若反复断开，请检查签名是否含网络扩展或改用外部连接。本机 VPN 已断开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
