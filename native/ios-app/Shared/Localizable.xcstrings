    "Poki Runner did not start. In Settings → Developer, turn on UI Automation; in Settings → General → VPN & Device Management, trust the developer of Poki Runner." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki Runner 没有启动。请在“设置 › 开发者”中开启 UI 自动化，并在“设置 › 通用 › VPN 与设备管理”中信任 Poki Runner 的开发者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki Runner 沒有啟動。請在「設定 › 開發者」中開啟 UI 自動化，並在「設定 › 通用 › VPN 與裝置管理」中信任 Poki Runner 的開發者。"
          }
        }
      }
    },
