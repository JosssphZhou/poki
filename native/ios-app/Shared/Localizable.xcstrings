        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在电脑上用 Poki Setup 重新配对并将新文件发至此手机，旧密钥会被替换。恢复设备、还原“位置与隐私”或手机遗忘配对后会出现此情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
