    "%@ is signing in through %@ and returns to %@, which isn’t on Poki’s list of known agents. Allow it only if you are connecting it yourself right now. It could then see your screen and act on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在通过 %@ 登录并返回 %@，后者不在 Poki 的已知智能体列表中。只有在你此刻正亲自连接它时才允许。允许后它可以看到你的屏幕并在此 iPhone 上操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
