          }
        }
      }
    },
    "Poki signs in again when its signing is due, and asks you for the password then." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名到期时 Poki 会重新登录，届时会向你询问密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名到期時 Poki 會重新登入，屆時會向你詢問密碼。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Poki starts it again on the next agent request." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体下次发出请求时，Poki 会重新启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 代理下次發出請求時，Poki 會重新啟動它。"
          }
        }
      }
    },
    "Poki stays active in the background without the location indicator, and never records your location." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 在后台保持活跃且不显示定位指示，绝不记录你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
