          }
        }
      }
    },
    "Tap to Open Poki" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点以打开 Poki"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點以開啟 Poki"
          }
        }
      }
    },
    "Poki restarted so agents can see the screen again. It turns on when it opens." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 已重启以便智能体恢复读取屏幕，打开后会自动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 已重啟以便智慧體恢復讀取螢幕，開啟後會自動開啟。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki restarted so agents can see the screen again. It turns on automatically when opened."
          }
        }
      }
    },
    "Poki sends touches and keys over a screen-sharing session, and iOS turns the camera off in every app while one is open, so Poki opens it only for an action and closes it 5 seconds after the last one. With this on, Poki opens no session at all. If taps and typing still work, the camera is never affected; if they stop working, turn it off. Takes effect the next time Poki turns on." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 默认通过屏幕共享会话发送触控和按键（会话期间 iOS 会关闭相机）。开启此项后不再建立该会话，相机不受影响；若点击或输入失效请关闭此项。下次开启 Poki 时生效。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki sends touches and keys over a screen-sharing session, which disables cameras while open, so Poki opens it only during actions. With this on, Poki opens no session at all so cameras stay unaffected; turn it off if taps or typing stop working. Takes effect next time Poki turns on."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 預設透過螢幕共享工作階段傳送觸控和按鍵（工作階段期間 iOS 會關閉相機）。開啟此項後不再建立該工作階段，相機不受影響；若點擊或輸入失效請關閉此項。下次開啟 Poki 時生效。"
          }
        }
      }
    },
    "Open Poki so agents can see the screen again. It restarts once." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开 Poki 以恢复智能体的屏幕画面（将重启一次）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟 Poki 以恢復智慧體的螢幕畫面（將重啟一次）。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Poki so agents can see the screen again. It will restart once."
          }
        }
      }
    },
