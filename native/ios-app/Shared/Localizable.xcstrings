    "The iPhone's passcode never opens history. To turn this off, set a PIN first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 的密码永远无法打开历史记录。要关闭此项，请先设置 PIN。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 的密碼永遠無法打開歷史記錄。要關閉此項，請先設定 PIN。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật mã iPhone không bao giờ mở được lịch sử. Để tắt mục này, hãy đặt mã PIN trước."
          }
        }
      }
    },
    "The two PINs did not match. Try again." : {
