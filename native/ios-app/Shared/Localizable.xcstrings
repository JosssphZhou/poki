    "%@ is chosen, but nothing answers at 10.7.0.1 right now. Open %lld, make sure it is connected with the loopback on, then come back. This page updates by itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择 %@，但 10.7.0.1 无应答。请打开 %lld，确认已开启本地连接并连接后再返回，状态会自动更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇 %@，但 10.7.0.1 無應答。請開啟 %lld，確認已開啟本機連線並連線後再返回，狀態會自動更新。"
          }
        },
