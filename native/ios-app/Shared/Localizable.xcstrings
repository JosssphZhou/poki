          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款、選單和確認彈窗中的刪除（以及缺少完整頁面資訊時，例如僅憑按鈕名稱發起語音操作時符合條件的刪除）和「錢包」操作始終需要你確認，其他敏感步驟直接進行。"
          }
