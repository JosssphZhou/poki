    "No extra app needed. Poki connects only to this iPhone; your normal traffic and DNS stay on their usual routes. iOS shows it as a VPN, so it may disconnect another VPN app." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No extra app needed. Poki connects only to this iPhone; your normal traffic and DNS stay on their usual routes. iOS shows it as a VPN, so it may disconnect another VPN app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需额外应用。Poki 仅连接此 iPhone 本机，日常流量和 DNS 仍走原有线路。iOS 会将其显示为 VPN，开启时可能会断开其他 VPN 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需額外應用程式。Poki 僅連線此 iPhone 本機，日常流量和 DNS 仍走原有線路。iOS 會將其顯示為 VPN，開啟時可能會中斷其他 VPN 應用程式。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần ứng dụng phụ. Poki chỉ kết nối tới chính iPhone này; lưu lượng và DNS thông thường vẫn đi theo đường cũ. iOS hiển thị nó như một VPN nên có thể ngắt ứng dụng VPN khác."
          }
        }
      }
    },
    "This happens after a restore, a reset of Location & Privacy, or when the phone forgot Poki. Pair again from Poki Setup on your computer and send the new file here; the old key is replaced." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair again from Poki Setup on your computer and send the new file here; the old key is replaced. This happens after a restore, a reset of Location & Privacy, or when the phone forgets Poki."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在电脑上用 Poki Setup 重新配对并将新文件发至此手机，旧密钥会被替换。恢复设备、还原“位置与隐私”或手机遗忘配对后会出现此情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在電腦上用 Poki Setup 重新配對並將新檔案傳至此手機，舊金鑰會被取代。回復裝置、重置「定位服務與隱私權」或手機遺忘配對後會出現此情況。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này xảy ra sau khi khôi phục, đặt lại Vị trí & Quyền riêng tư, hoặc khi điện thoại quên Poki. Ghép nối lại từ Poki Setup trên máy tính và gửi tệp mới sang đây; khóa cũ sẽ được thay thế."
          }
        }
      }
    },
