    "Delete Saved Passcode" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除已存密码"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除已存密碼"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mật mã đã lưu"
          }
        }
      }
    },
    "Enter your 4- or 6-digit iPhone passcode. Poki uses it only on the lock screen." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 4 位或 6 位 iPhone 锁屏密码。Poki 只在锁定屏幕上使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入 4 位或 6 位 iPhone 鎖定畫面密碼。Poki 只在鎖定畫面上使用它。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập mật mã iPhone 4 hoặc 6 chữ số của bạn. Poki chỉ dùng mật mã này trên màn hình khóa."
          }
        }
      }
    },
    "Poki couldn’t delete the saved passcode. Try again to turn off Automatic Unlock." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 未能删除已存的密码。请重试以关闭自动解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 未能刪除已存的密碼。請重試以關閉自動解鎖。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki không thể xóa mật mã đã lưu. Hãy thử lại để tắt Tự động mở khóa."
          }
        }
      }
    },
    "Poki could not confirm the unlock. Unlock your iPhone manually and check your saved passcode." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 未能确认解锁。请手动解锁 iPhone，并检查已存的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 未能確認解鎖。請手動解鎖 iPhone，並檢查已存的密碼。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki không thể xác nhận việc mở khóa. Hãy mở khóa iPhone thủ công và kiểm tra mật mã đã lưu."
          }
        }
      }
    },
    "Poki stores your passcode on this iPhone to unlock it for tasks you start in Poki. Turning this off deletes the passcode." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 将密码保存在这台 iPhone 上，用于在你发起任务时解锁。关闭后会删除密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 將密碼儲存在這部 iPhone 上，用於在你發起任務時解鎖。關閉後會刪除密碼。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki lưu mật mã trên iPhone này để mở khóa cho các tác vụ bạn bắt đầu trong Poki. Tắt mục này sẽ xóa mật mã."
          }
        }
      }
    },
