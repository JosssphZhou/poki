          "stringUnit" : {
            "state" : "translated",
            "value" : "运行日志列出每次例程运行、停止的位置和耗时，不含键入的文本。它帮助 Poki 维护者让例程更可靠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
