    "This iPhone answers at 10.7.0.1 (%lld ms)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 在 10.7.0.1 应答（%lld 毫秒）。"
