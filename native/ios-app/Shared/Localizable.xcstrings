    "Poki closed after you stopped it. Open it to turn it on again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你停止 Poki 后它已关闭。打开它即可重新开启。"
