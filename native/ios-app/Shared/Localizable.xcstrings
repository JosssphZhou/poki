        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản giao thức dịch vụ chuyển tiếp không tương thích"
          }
        }
      }
    },
    "The relay is temporarily busy" : {
      "localizations" : {
