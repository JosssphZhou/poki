    },
    "%@ is signing in through %@ and returns to %lld, which isn’t on Poki’s list of known agents. Allow it only if you are connecting it yourself right now. It could then see your screen and act on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正通过 %@ 登录并跳转至未知智能体 %lld。仅在你本人此刻发起连接时才允许；允许后对方可查看屏幕并操作此 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正透過 %@ 登入並跳轉至未知智慧體 %lld。僅在你本人此刻發起連線時才允許；允許後對方可查看螢幕並操作此 iPhone。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang đăng nhập qua %@ và quay về %lld, không có trong danh sách tác nhân đã biết của Poki. Chỉ cho phép nếu chính bạn đang kết nối ngay lúc này. Sau đó, nó có thể xem màn hình và thao tác trên iPhone này."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is signing in through %@ and redirecting to %lld, which isn’t a known agent. Allow only if you initiated this connection right now; it grants screen view and control of this iPhone."
          }
        }
      }
    },
