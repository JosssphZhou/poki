            "state" : "translated",
            "value" : "Ghi chú"
          }
        }
      }
    },
    "Every agent sees these notes before a task. They stay on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个智能体在任务开始前都会读取这些备忘。仅保存在此 iPhone 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個智慧體在任務開始前都會讀取這些備忘。僅儲存在此 iPhone 上。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi tác nhân đều thấy các ghi chú này trước khi thực hiện tác vụ. Chúng chỉ lưu trên iPhone này."
          }
        },
        "en" : {
          "stringUnit" : {
