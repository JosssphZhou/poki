    "Mounting the developer disk image timed out. Poki needs the internet once after each restart to get Apple's signature; check Wi-Fi or cellular. Poki tries again by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "装载开发者磁盘映像超时。每次重启后 Poki 需要联网一次以获取 Apple 的签名，请检查无线局域网或蜂窝网络。Poki 会自动重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝載開發者磁碟映像超時。每次重啟後 Poki 需要聯網一次以獲取 Apple 的簽名，請檢查無線區域網或蜂窩網路。Poki 會自動重試。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mounting the developer disk image timed out. Poki needs the internet once after each restart to get Apple's signature. Check Wi-Fi or cellular. Poki tries again by itself."
          }
        }
      }
    },
