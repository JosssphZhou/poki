          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một liên kết mang theo tệp ghép nối cho Poki. Tệp này sẽ thay thế ghép nối hiện tại của iPhone này và tác vụ tự động hóa sẽ dừng nếu tệp bị sai. Chỉ cho phép nếu bạn tự tạo tệp này trong Poki Setup."
          }
        }
      }
    },
