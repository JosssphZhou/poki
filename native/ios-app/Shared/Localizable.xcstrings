    },
    "Poki needs attention" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 需要你处理"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 需要你處理"
          }
        }
      }
    },
    "Poki needs the internet once after each restart of the phone to get Apple's signature for the developer disk image. Check Wi-Fi or cellular; Poki tries again by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机每次重启后，Poki 需要联网一次，为开发者磁盘映像获取 Apple 的签名。请检查无线局域网或蜂窝网络，Poki 会自动重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機每次重啟後，Poki 需要聯網一次，為開發者磁碟映像獲取 Apple 的簽名。請檢查無線區域網或蜂窩網路，Poki 會自動重試。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki needs the internet once after each restart of the phone to get Apple's signature for the developer disk image. Check Wi-Fi or cellular. Poki tries again by itself."
          }
        }
      }
    },
    "Poki needs your OK" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 需要你批准"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 需要你批准"
          }
        }
      }
    },
    "Poki shows steps, pairing codes, and approvals on the Lock Screen." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 会在锁定屏幕上显示操作步骤、配对码和批准请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
