        }
      }
    },
    "Poki asks you before an agent pays, deletes, sends a message, places a call, types a password or does anything in Wallet: on the Live Activity, in a notification, or here in Poki. Turned off, agents do all of that without asking. Changes take effect the next time Poki opens." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体付款、删除、发消息、打电话、输密码或操作“钱包”前，Poki 会先请求批准（可通过实时活动、通知或 App 内操作）。关闭后不再询问，下次启动生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智慧體付款、刪除、傳訊息、打電話、輸密碼或操作「錢包」前，Poki 會先請求批准（可透過即時動態、通知或 App 內操作）。關閉後不再詢問，下次啟動生效。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki asks before an agent pays, deletes, sends messages, places calls, enters passwords, or uses Wallet. Approve via Live Activity, notifications, or inside Poki. If off, agents act without asking. Takes effect next launch."
          }
        }
      }
    },
    "Poki can tap, type, and scroll on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 可在此 iPhone 上点按、输入和滑动。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki can tap, type, and scroll on this iPhone."
          }
