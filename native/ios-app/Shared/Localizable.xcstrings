        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據使用者示範建立例程"
          }
        }
      }
    },
    "Experimental. Observed corrections become user-assisted checkpoints, never guessed taps or unattended replay. Off by default." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实验性功能。观察到的纠正会成为由用户协助的检查点，绝不会变成猜测的轻点或无人值守的重放。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "實驗性功能。觀察到的糾正會成為由使用者協助的檢查點，絕不會變成猜測的輕點或無人值守的重放。預設關閉。"
          }
        }
      }
