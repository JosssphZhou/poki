  "Show me the full plan.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Show me the full plan."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "给我看看完整计划。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "給我看看完整計劃。"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Cho tôi xem toàn bộ kế hoạch."
        }
      }
    }
  },
  "Tomorrow’s plan  \n9:00 — Start with your most important task.  \n12:00 — Take a lunch break.  \n12:45 — Go for a short walk.  \n14:00 — Catch up on messages.  \n16:30 — Review today’s progress.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Tomorrow’s plan  \n9:00 — Start with your most important task.  \n12:00 — Take a lunch break.  \n12:45 — Go for a short walk.  \n14:00 — Catch up on messages.  \n16:30 — Review today’s progress."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "明天的安排  \n09:00　先完成最重要的事  \n12:00　吃午饭，休息一下  \n12:45　出门散步  \n14:00　集中回复消息  \n16:30　整理今天的进度"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "明天的安排  \n09:00　先完成最重要的事  \n12:00　吃午餐，休息一下  \n12:45　出門散步  \n14:00　集中回覆訊息  \n16:30　整理今天的進度"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Kế hoạch ngày mai  \n9:00 — Bắt đầu với tác vụ quan trọng nhất.  \n12:00 — Nghỉ ăn trưa.  \n12:45 — Đi dạo ngắn.  \n14:00 — Trả lời các tin nhắn.  \n16:30 — Xem lại tiến độ trong ngày."
        }
      }
    }
  },
  "Help me plan tomorrow.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Help me plan tomorrow."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "帮我安排一下明天的计划。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "幫我安排一下明天的計劃。"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Giúp tôi lên kế hoạch cho ngày mai."
        }
      }
    }
  },
  "Start with your most important task in the morning. Leave time for lunch and a short walk.\n\nI can also help you set a reminder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Start with your most important task in the morning. Leave time for lunch and a short walk.\n\nI can also help you set a reminder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "上午先完成最重要的事情，午间留出吃饭和散步的时间。\n\n我还可以帮你设置提醒。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "上午先完成最重要的事情，午間留出吃飯和散步的時間。\n\n我還可以幫你設定提醒。"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Hãy bắt đầu buổi sáng với tác vụ quan trọng nhất. Dành thời gian ăn trưa và đi dạo ngắn.\n\nTôi cũng có thể giúp bạn đặt lời nhắc."
        }
      }
    }
  },
