    "Poki Runner did not start. In Settings → Developer, turn on UI Automation; in Settings → General → VPN & Device Management, trust the developer of Poki Runner." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置 › 开发者”中开启 UI 自动化，并在“设置 › 通用 › VPN 与设备管理”中信任开发者。Poki Runner 未能启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定 › 開發者」中開啟 UI 自動化，並在「設定 › 一般 › VPN 與裝置管理」中信任開發者。Poki Runner 未能啟動。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki Runner không khởi động được. Trong Cài đặt → Nhà phát triển, hãy bật Tự động hóa UI; trong Cài đặt → Cài đặt chung → Quản lý VPN & Thiết bị, hãy tin cậy nhà phát triển của Poki Runner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on UI Automation in Settings › Developer, and trust Poki Runner’s developer in Settings › General › VPN & Device Management. Poki Runner couldn’t start."
          }
        }
      }
    },
    "Poki Runner is installed and trusted" : {
      "localizations" : {
