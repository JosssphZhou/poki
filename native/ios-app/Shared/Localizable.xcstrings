            "value" : "遷移或備份"
          }
        }
      }
    },
    "One file with every routine and note. Importing merges it in, and the newer copy of a routine wins. Poki Setup on your computer can back it up and put it back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有流程和备忘导出为单个文件。导入时自动合并并保留较新版本，也可用电脑上的 Poki Setup 备份与恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有流程和備忘匯出為單一檔案。匯入時自動合併並保留較新版本，也可用電腦上的 Poki Setup 備份與還原。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exports one file with all routines and notes. Importing merges entries, keeping newer versions. Poki Setup on your computer can also back up and restore it."
          }
        }
      }
    },
    "Clear Memory" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除记忆"
