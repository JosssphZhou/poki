        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on the loopback in your proxy app. That is the Poki module in Surge or Loon, loopback_address in sing-box, or Shadowrocket's Settings → Other → \"Include route 10.7.0.1/32\". Then connect to Wi-Fi."
