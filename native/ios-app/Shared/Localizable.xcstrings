    "Poki cannot start the usual way because the local connection is off. Turn the loopback on in your proxy app, or start anyway with iOS’s automation banner showing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在代理 App 中开启本地连接，或允许显示 iOS 运行提示条直接启动。本地连接当前已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在代理 App 中開啟本機連線，或允許顯示 iOS 運行提示條直接啟動。本機連線目前已關閉。"
          }
        },
        "vi" : {
          "stringUnit" : {
