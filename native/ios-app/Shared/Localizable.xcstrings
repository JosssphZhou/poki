    },
    "Poki closes by itself so agents can see the screen again. Open Poki again afterwards, from the notification or the Home Screen. It turns on when it opens." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 会自行关闭，以便智能体重新看到屏幕。之后请从通知或主屏幕重新打开 Poki。打开后会自动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 會自行關閉，以便AI 代理重新看到螢幕。之後請從通知或主螢幕重新開啟 Poki。開啟後會自動開啟。"
          }
        }
      }
    },
    "Enter Your Passcode Next" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来请输入锁屏密码"
