    "%@ is signing in through %@ with callback destination %@. Allow it only if you are connecting it yourself right now. It could then see your screen and act on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在通过 %2$@ 登录，回调目标为 %3$@。请仅在你正在连接此客户端时允许。获准后，它可查看屏幕并在此 iPhone 上操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在透過 %2$@ 登入，回呼目的地為 %3$@。請只在你正在連接此用戶端時允許。獲准後，它可查看螢幕並在此 iPhone 上操作。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang đăng nhập qua %@ với đích gọi lại %@. Chỉ cho phép nếu chính bạn đang kết nối ngay lúc này. Sau đó, nó có thể xem màn hình và thao tác trên iPhone này."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is signing in through %@ with callback destination %@. Allow it only if you are connecting it yourself right now. It could then see your screen and act on this iPhone."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
