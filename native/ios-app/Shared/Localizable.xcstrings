    "Every tap, swipe and keystroke Poki makes on this iPhone is listed here, whoever asked for it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 在此 iPhone 上的每次轻点、轻扫和按键都会列在这里，无论由谁发起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 在此 iPhone 上的每次輕點、輕掃和按鍵都會列在這裡，無論由誰發起。"
          }
        },
        "vi" : {
