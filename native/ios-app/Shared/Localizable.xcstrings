          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nguyên bàn phím thường dùng của bạn. Poki sẽ chuyển sang bàn phím của mình khi nhập liệu và chuyển lại khi xong."
          }
        }
      }
    },
    "Poki keeps itself running with silent audio. Always Allow makes that sturdier, and iOS shows no location indicator for it. Poki never records your location." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 通过静音音频保持运行。“始终允许”会让它更稳定，且 iOS 不会为此显示定位指示器。Poki 从不记录你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 透過靜音音訊保持執行。「始終允許」會讓它更穩定，且 iOS 不會為此顯示定位指示器。Poki 從不記錄你的位置。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki tự duy trì hoạt động bằng âm thanh im lặng. Luôn cho phép giúp cơ chế này ổn định hơn và iOS không hiển thị chỉ báo vị trí. Poki không bao giờ ghi lại vị trí của bạn."
          }
        }
      }
    },
