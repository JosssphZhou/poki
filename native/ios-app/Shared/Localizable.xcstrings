{
  "sourceLanguage" : "en",
  "strings" : {
    "Relay protocol version is incompatible" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程连接服务协议版本不兼容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端連線服務通訊協定版本不相容"
