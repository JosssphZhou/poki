          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复 iPhone、还原“位置与隐私”或 iPhone 忘记 Poki 后会出现这种情况。重新配对即可，旧密钥会被替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢復 iPhone、還原「位置與隱私」或 iPhone 忘記 Poki 後會出現這種情況。重新配對即可，舊金鑰會被替換。"
          }
        }
      }
    },
    "This iOS version needs a newer developer disk image. Open Poki's setup to download the latest image, or update Poki." : {
