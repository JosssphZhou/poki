        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for the current connection change to finish, then try again."
          }
        }
      }
    },
    "Could not start Poki's local VPN. Allow the VPN configuration when asked. If signing does not include Network Extensions, use the external-connection build with LocalDevVPN or a compatible proxy." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在弹窗中允许 VPN 配置；若签名不含网络扩展，请改用外部代理通道版搭配 LocalDevVPN 或代理。无法启动 内置本地连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在彈窗中允許 VPN 設定；若簽名不含網路延伸功能，請改用外部代理通道版搭配 LocalDevVPN 或代理。無法啟動 內建本機連線。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khởi chạy VPN nội bộ của Poki. Hãy cho phép cấu hình VPN khi được hỏi. Nếu bản ký không gồm Network Extensions, hãy dùng bản kết nối ngoài với LocalDevVPN hoặc proxy tương thích."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow the VPN configuration if prompted, or use the external-connection build with LocalDevVPN or a proxy if signing lacks Network Extensions. Couldn’t start Poki’s local VPN."
          }
        }
      }
    },
    "The local VPN disconnected. Reconnect here. If it keeps stopping, check that both Poki and its tunnel were signed with Network Extensions, or choose an external connection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在此重新连接；若反复断开，请检查签名是否含网络扩展或改用外部代理通道。内置本地连接已断开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在此重新連線；若反覆中斷，請檢查簽名是否含網路延伸功能或改用外部代理通道。內建本機連線已中斷。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN nội bộ đã ngắt kết nối. Kết nối lại tại đây. Nếu vẫn liên tục ngắt, hãy kiểm tra cả Poki và đường hầm có được ký kèm Network Extensions không, hoặc chọn kết nối ngoài."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnect here, or choose an external connection if signing lacks Network Extensions. The local VPN disconnected."
          }
        }
      }
    },
    "Another VPN appears to be on, so Poki did not turn its local connection back on. Turn that VPN off and tap Enable Local Connection, or choose an external connection in Setup." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先关闭其他 VPN 再轻点“开启 内置本地连接”，或在“配置”中改用外部代理通道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先關閉其他 VPN 再輕點「開啟 內建本機連線」，或在「配置」中改用外部代理通道。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ một VPN khác đang bật nên Poki không bật lại kết nối nội bộ. Hãy tắt VPN đó rồi chạm Bật kết nối nội bộ, hoặc chọn kết nối ngoài trong Thiết lập."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off the other active VPN and tap Enable Local Connection, or choose an external connection in Setup."
          }
        }
