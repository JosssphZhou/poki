        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi tác vụ tới Poki"
          }
        }
      }
    },
    "Settings › Action Button › Shortcut › Poki Anytime" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 › 操作按钮 › 快捷指令 › 随时 Poki"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
