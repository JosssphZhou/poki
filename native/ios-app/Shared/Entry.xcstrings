          }
        }
      }
    },
    "Poki is doing a task. Here it is." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 正在执行任务，以下是当前进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 正在執行任務，以下是目前進度。"
