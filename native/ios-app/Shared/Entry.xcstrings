            "state" : "translated",
            "value" : "Trò chuyện với Poki"
          }
        }
      }
    },
    "Task" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务"
          }
        },
