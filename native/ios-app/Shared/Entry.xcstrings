            "value" : "Cài đặt › Nút Tác vụ › Phím tắt › Poki Anytime"
          }
        }
      }
    },
    "Talk to Poki" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Poki 说话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
