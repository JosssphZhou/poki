#!/usr/bin/env python3
import argparse
import getpass
import hashlib
import json
import os
from pathlib import Path
import platform
import plistlib
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from urllib.parse import quote, urlsplit
import uuid


VERSION = '1.9.12'
RELEASE = 'https://github.com/BlueBubblesApp/bluebubbles-server/releases/download/v' + VERSION
ASSETS = {
    'arm64': ('BlueBubbles-1.9.12-arm64-mac.zip', 'e1d96d67fe4fc79ad44a8f1eeac3de78eef561635842b66d380dd3eba5092d89'),
    'x86_64': ('BlueBubbles-1.9.12-mac.zip', '7078ea4302b4df6ab4b236bdaea84440aabf95b2a07b281919fd0ef8822e958c'),
}
NEXT_STEPS = '''Finish setup yourself (the installer does not open apps or send messages):
1. Open Messages > Settings > iMessage and sign in to your Apple Account.
2. Open the installed BlueBubbles.app. Follow Intro > Permissions. In System
   Settings > Privacy & Security, grant Full Disk Access and Accessibility to
   this copy of BlueBubbles. Allow Messages automation when macOS asks.
3. In BlueBubbles Connection, set the same server password you supplied here
   and click the save icon. Keep the local server URL/port consistent with it.
   Follow any remaining onboarding prompts in BlueBubbles yourself.
4. Private API and disabling SIP are not required for Poki's plain-text channel.
   See docs/imessage-gateway.md before checking or starting the channel.'''
PROVIDERS = '''How should Poki reach iMessage?

1. BlueBubbles (default)
   Runs on this Mac and uses your own Messages account. Task text and replies
   stay on your machine. Setup installs BlueBubbles Server; you sign in to
   Messages and keep both running. macOS only.

2. Photon
   Photon hosts the iMessage line, so you run only the Poki worker, on macOS
   or Linux. You text a number Photon assigns to you. Task text and replies
   pass through Photon's servers. Setup signs you in to Photon in a browser.
'''
PHOTON_NEXT_STEPS = '''Finish setup yourself (no message was sent and no worker was started):
1. Run node bin/poki-photon.mjs --assign to map the sender to a shared Photon
   iMessage line, or assign it in the Photon dashboard under iMessage.
2. From the allowed sender, send an iMessage to the assigned number. A shared
   line can only reply after the sender has messaged it.
3. Run node bin/poki-photon.mjs --check, then node bin/poki-photon.mjs.
   See docs/photon-channel.md before starting the channel.'''


def ask(label, default=None):
    answer = input(label + (f' [{default}]' if default else '') + ': ').strip()
    return answer or default or ''


def settings(answers):
    if answers:
        path = Path(answers)
        if path.stat().st_mode & 0o077:
            raise ValueError('The answers file must be private. Run chmod 600 on it.')
        try:
            data = json.loads(path.read_text())
        except (ValueError, OSError):
            raise ValueError('Cannot read the private answers file as JSON.') from None
    else:
        if not sys.stdin.isatty():
            raise ValueError('Use a terminal for hidden password input, or pass --answers with a private JSON file.')
        print('Choose a server password now, then set the same password in BlueBubbles during onboarding.')
        data = {'url': ask('Local BlueBubbles server URL', 'http://127.0.0.1:1234'),
                'sender': ask('Allowed iMessage sender (email or phone number)'),
                'device': ask('Poki device name or ID')}
        data['chatGuid'] = ask('Exact direct chat GUID', 'iMessage;-;' + data['sender'])
        data['password'] = getpass.getpass('BlueBubbles server password (hidden): ')
    if not isinstance(data, dict):
        raise ValueError('Answers must be a JSON object.')
    for field in ['url', 'sender', 'device', 'password']:
        if not isinstance(data.get(field), str) or not data[field].strip():
            raise ValueError(f'Missing {field} in setup answers.')
    data['sender'] = data['sender'].strip()
    if ';' in data['sender']:
        raise ValueError('Configure exactly one sender, without semicolons.')
    url = urlsplit(data['url'])
    if (url.scheme != 'http' or url.hostname not in ['localhost', '127.0.0.1', '::1']
            or url.username or url.password or url.path not in ['', '/'] or url.query or url.fragment):
        raise ValueError('Use a loopback HTTP server URL without credentials, path or query.')
    try:
        url.port
    except ValueError:
        raise ValueError('Invalid server port.') from None
    chat = data.get('chatGuid', 'iMessage;-;' + data['sender'])
    if chat not in ['iMessage;-;' + data['sender'], 'any;-;' + data['sender']]:
        raise ValueError('Use the exact direct chat GUID for the allowed sender.')
    return ({'sender': data['sender'], 'chatGuid': chat, 'device': data['device'], 'auth': 'chatgpt'},
            {'url': data['url'], 'password': data['password']})


def install(args):
    if platform.system() != 'Darwin' or platform.machine() not in ASSETS:
        raise ValueError('BlueBubbles requires an Apple Silicon or Intel Mac.')
    app_dir = Path(args.app_dir).expanduser().resolve()
    config_dir = Path(args.config_dir).expanduser().absolute()
    app = app_dir / 'BlueBubbles.app'
    if os.path.lexists(app) or os.path.lexists(config_dir):
        raise ValueError('The app or configuration destination already exists; nothing was changed. Choose unused directories.')
    config, connection = settings(args.answers)
    filename, digest = ASSETS[platform.machine()]
    installed = False
    configured = False
    try:
        with tempfile.TemporaryDirectory(prefix='poki-bluebubbles-') as temporary:
            work = Path(temporary)
            archive = work / filename
            if args.archive:
                shutil.copyfile(Path(args.archive).expanduser(), archive)
            else:
                print(f'Downloading official BlueBubbles {VERSION} for {platform.machine()}...', flush=True)
                result = subprocess.run(['curl', '--fail', '--location', '--silent', '--show-error',
                                         '--proto', '=https', '--proto-redir', '=https', '--connect-timeout', '20',
                                         '--max-time', '600', '--output', str(archive), RELEASE + '/' + filename],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if result.returncode:
                    raise ValueError('Download failed. No app or channel configuration was installed; retry when the official release is reachable.')
            with archive.open('rb') as stream:
                actual = hashlib.file_digest(stream, 'sha256').hexdigest()
            if actual != digest:
                raise ValueError('Checksum verification failed. No app or channel configuration was installed.')
            print(f'BlueBubbles {VERSION} checksum verified.', flush=True)
            extracted = work / 'extracted'
            subprocess.run(['/usr/bin/ditto', '-x', '-k', str(archive), str(extracted)], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            source = extracted / 'BlueBubbles.app'
            with (source / 'Contents/Info.plist').open('rb') as stream:
                if plistlib.load(stream).get('CFBundleShortVersionString') != VERSION:
                    raise ValueError('The extracted app has an unexpected version.')
            app_dir.mkdir(parents=True, exist_ok=True)
            with tempfile.TemporaryDirectory(prefix='.poki-bluebubbles-', dir=app_dir) as staging:
                staged = Path(staging) / 'BlueBubbles.app'
                subprocess.run(['/usr/bin/ditto', str(source), str(staged)], check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if os.path.lexists(app):
                    raise ValueError('The app destination now exists; it was left unchanged.')
                staged.rename(app)
                installed = True
            config_dir.mkdir(parents=True, mode=0o700)
            configured = True
            for name, value in [('imessage.json', config), ('connection.json', connection)]:
                with (config_dir / name).open('x') as stream:
                    os.fchmod(stream.fileno(), 0o600)
                    json.dump(value, stream, indent=2)
                    stream.write('\n')
    except BaseException:
        if configured:
            shutil.rmtree(config_dir)
        if installed:
            shutil.rmtree(app)
        raise
    print(f'Installed BlueBubbles {VERSION}: {app}\nPrivate channel configuration: {config_dir}')
    print(NEXT_STEPS)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def photon(method, path, token=None, body=None):
    base = os.environ.get('PHOTON_API_URL', 'https://api.photon.codes').rstrip('/')
    if base != 'https://api.photon.codes':
        url = urlsplit(base)
        if (url.scheme != 'http' or url.hostname not in ['localhost', '127.0.0.1', '::1']
                or url.username or url.password or url.path or url.query or url.fragment):
            raise ValueError('PHOTON_API_URL must be the Photon API or a loopback HTTP development server.')
    headers = {'accept': 'application/json', 'user-agent': 'poki-setup-channels'}
    if token:
        headers['authorization'] = 'Bearer ' + token
    if method != 'GET':
        headers['idempotency-key'] = str(uuid.uuid4())
    if body is not None:
        headers['content-type'] = 'application/json'
    request = urllib.request.Request(base + path, method=method, headers=headers,
                                     data=None if body is None else json.dumps(body).encode())
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=30) as response:
            return response.status, json.load(response)
    except urllib.error.HTTPError as error:
        try:
            return error.code, json.load(error)
        except ValueError:
            return error.code, {}
    except (OSError, ValueError):
        raise ValueError('Cannot reach Photon. Check the network and run setup again.') from None


def photon_sign_in():
    status, grant = photon('POST', '/v1/auth/device/code', body={})
    if status != 200:
        raise ValueError(f'Photon did not start the sign-in (HTTP {status}). Run setup again later.')
    print(f"Sign in to Photon to continue. Open this link in a browser:\n  {grant['verification_uri_complete']}\n"
          f"and confirm the code {grant['user_code']}. Waiting for your approval...", flush=True)
    wait = grant['interval']
    deadline = time.monotonic() + grant['expires_in']
    while time.monotonic() < deadline:
        time.sleep(wait)
        status, result = photon('POST', '/v1/auth/device/token', body={
            'grant_type': 'urn:ietf:params:oauth:grant-type:device_code', 'device_code': grant['device_code']})
        if status == 200:
            print(f"Signed in to Photon as {result['user']['email']}.", flush=True)
            return result['access_token']
        if status == 429 or result.get('error') == 'slow_down':
            wait += 5
        elif result.get('error') != 'authorization_pending':
            raise ValueError(f"The Photon sign-in did not complete ({result.get('error') or f'HTTP {status}'}). Nothing was changed; run setup again.")
    raise ValueError('The Photon sign-in code expired before it was approved. Nothing was changed; run setup again.')


def photon_project(token, wanted, interactive):
    status, result = photon('GET', '/v1/organizations', token)
    if status != 200:
        raise ValueError(f'Photon did not list your organizations (HTTP {status}).')
    projects = []
    for organization in result['organizations']:
        page = ''
        while page is not None:
            status, result = photon('GET', f"/v1/organizations/{organization['organizationId']}/projects"
                                    + (f'?pageToken={quote(page)}' if page else ''), token)
            if status != 200:
                raise ValueError(f"Photon did not list the projects of {organization['name']} (HTTP {status}). Nothing was changed; run setup again later.")
            projects += [(project['projectId'], f"{project['name']} ({organization['name']}, {project['projectId']})")
                         for project in result['projects']]
            page = result.get('nextPageToken')
    if not projects:
        raise ValueError('This Photon account has no project it can read. Create one at https://photon.codes/docs/beta/get-started/project and run setup again.')
    if wanted:
        if wanted not in [project for project, _ in projects]:
            raise ValueError('This Photon account cannot read that project ID.')
        return wanted
    if len(projects) == 1:
        print(f'Using your Photon project {projects[0][1]}.')
        return projects[0][0]
    listing = '\n'.join(f'{number}. {label}' for number, (_, label) in enumerate(projects, 1))
    if not interactive:
        raise ValueError('This Photon account has several projects. Add projectId to the answers file:\n' + listing)
    print('Your Photon projects:\n' + listing)
    choice = ask('Project number')
    if not choice.isdigit() or not 0 < int(choice) <= len(projects):
        raise ValueError('Choose one of the listed project numbers.')
    return projects[int(choice) - 1][0]


def configure_photon(args):
    config_dir = Path(args.config_dir).expanduser().absolute()
    if os.path.lexists(config_dir):
        raise ValueError('The configuration destination already exists; nothing was changed. Choose an unused directory.')
    if args.answers:
        path = Path(args.answers)
        if path.stat().st_mode & 0o077:
            raise ValueError('The answers file must be private. Run chmod 600 on it.')
        try:
            data = json.loads(path.read_text())
        except (ValueError, OSError):
            raise ValueError('Cannot read the private answers file as JSON.') from None
    else:
        if not sys.stdin.isatty():
            raise ValueError('Use a terminal to answer the setup questions, or pass --answers with a private JSON file.')
        data = {'sender': ask('Allowed iMessage sender (email, or phone number with country code)'),
                'device': ask('Poki device name or ID')}
    if not isinstance(data, dict):
        raise ValueError('Answers must be a JSON object.')
    fields = ['sender', 'device']
    if 'apiKey' in data:
        fields += ['projectId', 'apiKey']
    elif 'projectId' in data:
        fields += ['projectId']
    for field in fields:
        if not isinstance(data.get(field), str) or not data[field].strip():
            raise ValueError(f'Missing {field} in setup answers.')
        data[field] = data[field].strip()
    if 'projectId' in data and not re.fullmatch(r'pho_prj_[0-9a-z]{26}', data['projectId']):
        raise ValueError('Use the Photon Beta project ID: pho_prj_ followed by 26 lowercase letters or digits.')
    name = key_id = None
    made = False
    try:
        if 'apiKey' not in data:
            try:
                token = photon_sign_in()
                project = data['projectId'] = photon_project(token, data.get('projectId'), not args.answers)
                name = ('Poki Agent on ' + platform.node())[:128] if platform.node() else 'Poki Agent'
                status, result = photon('POST', f'/v1/projects/{project}/api-keys', token, {
                    'name': name, 'permissions': ['project:read', 'project:write', 'platforms:read', 'platforms:write']})
                if status not in [200, 201]:
                    name = None
                    raise ValueError(f'Photon did not create a project API key (HTTP {status}). Your account may not manage keys in that project.')
                key_id = result['apiKey']['apiKeyId']
                secret = result['secret']
                data['apiKey'] = secret if secret.startswith('pho_sk_') else f'{key_id}_{secret}'
                status, _ = photon('GET', f'/v1/projects/{project}/messages?pageSize=1', data['apiKey'])
                if status in [401, 403]:
                    raise ValueError(f'Photon refused the API key it had just created (HTTP {status}).')
                print(f'Created the Photon project API key "{name}" ({key_id}) with project and platform read and write permissions.')
            except (KeyError, TypeError, AttributeError):
                raise ValueError('Photon answered in an unexpected form. Nothing was saved; run setup again later.') from None
        config_dir.mkdir(parents=True, mode=0o700)
        made = True
        for filename, value in [('photon.json', {'sender': data['sender'], 'device': data['device'], 'auth': 'chatgpt'}),
                                ('connection.json', {'projectId': data['projectId'], 'apiKey': data['apiKey']})]:
            with (config_dir / filename).open('x') as stream:
                os.fchmod(stream.fileno(), 0o600)
                json.dump(value, stream, indent=2)
                stream.write('\n')
    except BaseException:
        if made:
            shutil.rmtree(config_dir)
        if name and not isinstance(key_id, str):
            print(f'Photon may have created an API key named "{name}" that was not saved. Look under the project\'s API keys in the Photon dashboard and revoke it.', file=sys.stderr)
        elif name:
            try:
                revoked = photon('DELETE', f'/v1/projects/{project}/api-keys/{key_id}', token)[0] == 200
            except ValueError:
                revoked = False
            print(f'The new Photon API key "{name}" ({key_id}) was not saved. ' + ('Setup revoked it.' if revoked else
                  'It is still active: revoke it under the project\'s API keys in the Photon dashboard.'), file=sys.stderr)
        raise
    print(f'Private Photon channel configuration: {config_dir}')
    print(PHOTON_NEXT_STEPS)


def main():
    parser = argparse.ArgumentParser(description='Optionally install the pinned BlueBubbles gateway and configure Poki iMessage, or configure the Photon iMessage channel.')
    parser.add_argument('--channel', choices=['none', 'imessage'], help='Omit to choose interactively; default is none.')
    parser.add_argument('--provider', choices=['bluebubbles', 'photon'], help='How the imessage channel reaches iMessage. Omit to choose in a terminal; default is bluebubbles.')
    parser.add_argument('--app-dir', default='~/Applications', help='Application destination directory; existing apps are never replaced.')
    parser.add_argument('--config-dir', help='New private configuration directory; default is ~/.config/poki-agent/imessage for BlueBubbles and ~/.config/poki-agent/photon for Photon.')
    parser.add_argument('--answers', help='Private JSON file for unattended setup: url, password, sender, chatGuid and device for BlueBubbles; sender and device for Photon, plus projectId and apiKey to skip the browser sign-in.')
    parser.add_argument('--archive', help='Use an already downloaded official ZIP; the pinned checksum is still required.')
    args = parser.parse_args()
    channel = args.channel
    if channel is None:
        channel = ask('Optional messaging channel: none or imessage', 'none').lower()
    if channel == 'none':
        print('Skipped iMessage. No gateway downloaded or installed; existing Poki setup is unchanged.')
    elif channel == 'imessage':
        provider = args.provider
        if provider is None and not args.answers and sys.stdin.isatty():
            print(PROVIDERS)
            provider = {'1': 'bluebubbles', '2': 'photon'}.get(ask('Choose 1 or 2', '1'))
            if provider is None:
                raise ValueError('Choose 1 for BlueBubbles or 2 for Photon.')
        if provider == 'photon':
            args.config_dir = args.config_dir or '~/.config/poki-agent/photon'
            configure_photon(args)
        else:
            args.config_dir = args.config_dir or '~/.config/poki-agent/imessage'
            install(args)
    else:
        raise ValueError('Choose none or imessage.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError, EOFError, KeyboardInterrupt) as error:
        message = str(error) if isinstance(error, ValueError) else 'Setup could not finish. Check destination permissions and available disk space, then retry.'
        print('Setup failed: ' + message, file=sys.stderr)
        sys.exit(1)
